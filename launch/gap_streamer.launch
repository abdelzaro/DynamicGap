<launch>
    <!-- Start the gap streamer -->
    <node pkg="dynamic_gap" type="gap_streamer_polar" name="gap_streamer_polar" output="screen" />

    <!-- Optional: visualize the gaps in RViz -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find dynamic_gap)/rviz/gap_display.rviz" /> -->
</launch>
